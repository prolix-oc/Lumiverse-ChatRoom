{
  "name": "lumiverse-chatroom",
  "version": "1.1.0",
  "description": "Live Internet Shitposting Chatroom",
  "main": "index.js",
  "scripts": {
    "build:backend": "bun build src/backend.ts --outfile=dist/backend.js --target=browser",
    "build:frontend": "bun build src/frontend.ts --outfile=dist/frontend.js --target=browser",
    "build:widget": "bun build src/widget.ts --outfile=dist/widget.js --target=browser --minify",
    "build": "bun run build:backend && bun run build:frontend && bun run build:widget"
  },
  "dependencies": {
    "@tanstack/virtual-core": "^3.14.0",
    "lumiverse-spindle-types": "0.6.34"
  }
}
